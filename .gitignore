# Logs
*.log

# Build output. `node build.js` regenerates it from src/ every time, and CI
# builds it fresh before deploying — committing it would only create a way to
# ship a stale page.
_site/
node_modules/

# Env / secrets
.env
.env.local

# Full-resolution image masters. The site serves the WebP exports instead, so
# these ~7 MB of PNGs would sit in history forever without ever being fetched.
# Local-only: back them up elsewhere. See README > Images.
assets/originals/
